{
  "name": "mnemosyne",
  "private": true,
  "version": "0.1.0",
  "description": "Local MCP server for per-project AI memories",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @mnemosyne/desktop dev",
    "dev:backend": "pnpm --filter @mnemosyne/backend dev",
    "build:backend": "pnpm --filter @mnemosyne/backend build",
    "install:mcp": ".\\bin\\mnemosyne.exe install",
    "setup:codex": "codex mcp add mnemosyne -- \".\\bin\\mnemosyne.exe\" serve",
    "setup:claude": "claude mcp add mnemosyne -- \".\\bin\\mnemosyne.exe\" serve"
  }
}
